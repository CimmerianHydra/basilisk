metadata/_custom_type_script = "uid://y2qpi8g11dfa"

[sub_resource type="Resource" id="Resource_w10ft"]
script = ExtResource("5_88gwf")
metadata/_custom_type_script = "uid://burysipfp7k2a"

[sub_resource type="Resource" id="Resource_t5qya"]
script = ExtResource("5_2no3s")
speakers = Array[ExtResource("4_88gwf")]([ExtResource("2_xsk6p")])
text = "... or, at least, that's what happened according to the textbook."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_tp366"]
script = ExtResource("5_2no3s")
speakers = Array[ExtResource("4_88gwf")]([ExtResource("6_tp366")])
text = "Man... "
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_88gwf"]
script = ExtResource("5_2no3s")
speakers = Array[ExtResource("4_88gwf")]([ExtResource("6_tp366")])
text = "This stuff's too complicated."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_2no3s"]
script = ExtResource("5_2no3s")
speakers = Array[ExtResource("4_88gwf")]([ExtResource("6_tp366")])
text = "The universe is a really big place."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_dhbe7"]
script = ExtResource("5_2no3s")
speakers = Array[ExtResource("4_88gwf")]([ExtResource("2_xsk6p")])
text = "No textbook can ever capture just how big and impossible it all is."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_rm0ss"]
script = ExtResource("5_2no3s")
speakers = Array[ExtResource("4_88gwf")]([ExtResource("2_xsk6p")])
text = "It's bigger than our imagination too, after all."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_k0t4o"]
script = ExtResource("5_2no3s")
speakers = Array[ExtResource("4_88gwf")]([ExtResource("6_tp366")])
text = "Banger line."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_q85oe"]
script = ExtResource("5_2no3s")
speakers = Array[ExtResource("4_88gwf")]([ExtResource("6_tp366")])
text = "You're a good dude. I just wish you were out there studying that stuff instead of rotting here, like I am."
clear_behavior = 1
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_md81q"]
script = ExtResource("5_2no3s")
speakers = Array[ExtResource("4_88gwf")]([ExtResource("2_xsk6p")])
text = "I'll be out of here in no time."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_jmhq2"]
script = ExtResource("5_2no3s")
speakers = Array[ExtResource("4_88gwf")]([ExtResource("2_xsk6p")])
text = "And maybe we can get you out t-"
auto_advance_delay = 0.5
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_sos2p"]
script = ExtResource("5_2no3s")
text = "[center][i]KNOCK KNOCK.[/i][/center]"
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_2wtk4"]
script = ExtResource("5_2no3s")
speakers = Array[ExtResource("4_88gwf")]([ExtResource("6_tp366")])
text = "Sounds like lunchtime."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_mcxet"]
script = ExtResource("5_2no3s")
speakers = Array[ExtResource("4_88gwf")]([ExtResource("6_tp366")])
text = "Come on, let's go eat. Your brain needs food, too."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

