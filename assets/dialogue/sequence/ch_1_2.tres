[sub_resource type="Resource" id="Resource_ma4ir"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("10_u2f4e")])
text = "My sister is at that table. Would you excuse us for a moment?"
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_u2f4e"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("11_r40fw")])
text = "Dude, are you ever gonna let me talk to them?"
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_r40fw"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("10_u2f4e")])
text = "[i]Sigh...[/i]"
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_r56p8"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("5_v5oaj")])
text = "Who's the new guy?"
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_wmunh"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("10_u2f4e")])
text = "A friend."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_jxped"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("5_v5oaj")])
text = "Is he trusted?"
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_yepr1"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("10_u2f4e")])
text = "..."
letters_per_second = 1.0
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_s02f3"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("10_u2f4e")])
text = "Yeah, he's a good dude."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_6ihda"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("5_v5oaj")])
text = "Alright, then. Sit down."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_iwcai"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("5_v5oaj")])
text = "We saw SBH today."
clear_behavior = 1
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_qw1sb"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("5_v5oaj")])
text = "They were trying to pry him open and pick him apart."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_hiolw"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("10_u2f4e")])
text = "Holy shit! Really?"
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_qiqjs"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("5_v5oaj")])
text = "Quiet!..."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_h154m"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("11_r40fw")])
text = "I'm sorry, I'm a bit confused here. Who's SBH?"
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_pjtj5"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("7_r56p8")])
text = "Supermassive Black Hole."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_3wo4u"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("7_r56p8")])
text = "My mech."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_yvvii"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("11_r40fw")])
text = "You guys have a [i]mech[/i]?!"
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_jvbxr"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("5_v5oaj")])
text = "Will you keep your voice down?!..."
letters_per_second = 60.0
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_trhen"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("11_r40fw")])
text = "Sorry, this is just..."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_0pxfo"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("11_r40fw")])
text = "Bishop, who are these people?"
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_6lcls"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("10_u2f4e")])
text = "My sister Decaf and her boss, Catch-22."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_cyvwy"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("5_v5oaj")])
text = "We were trying to reach the blinkspace gate aboard SBH when a bunch of jackasses from this mining colony showed up."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_83su5"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("5_v5oaj")])
text = "Supermassive is strong, but... the systems were too damaged to function."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_ms3lv"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("5_v5oaj")])
text = "So they captured us."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_mabm3"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("7_r56p8")])
text = "And stole Supermassive Black Hole."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_c2oto"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("10_u2f4e")])
text = "And everything it was carrying."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_0683d"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("5_v5oaj")])
text = "But I was sure they would've sold him, or maybe even turned him into scrap by now."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_gkrxj"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("7_r56p8")])
text = "He's custom. No mechanic in the Outer Rim has a clue how the internals work."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_g41ko"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("7_r56p8")])
text = " Unless I'm there."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_wvm0k"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("7_r56p8")])
text = "Which is why I know no matter what they do to him, he won't even turn on."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_72olx"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("5_v5oaj")])
text = "They probably know every piece is worth a lot."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_xmx4k"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("7_r56p8")])
text = "And they can't turn him into a drilling mech, so they're trying to profit where they can."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_jmpbf"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("10_u2f4e")])
text = "Supermassive Black Hole is our ticket out of here."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_nvaxf"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("7_r56p8")])
text = "I promised I would get you out of your bind."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

[sub_resource type="Resource" id="Resource_4m7g5"]
script = ExtResource("13_wmunh")
speakers = Array[ExtResource("12_r56p8")]([ExtResource("7_r56p8")])
text = "I will keep that promise."
metadata/_custom_type_script = "uid://b0aqnksfjgvle"

