[sub_resource type="GDScript" id="GDScript_18xdr"]
script/source = "extends ActionComponent
class_name GiveActionPoint

@onready var action_point := self.get_child(0)

func execute(ctx: Dictionary) -> void:
	for unit in ctx[Action.TARGETS_KEY]:
		var template_resource := action_point.duplicate()
		unit.resource_library.add_child(template_resource)
"

